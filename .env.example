# ---------------------------------------------------------------------------
# JobScout configuration. Copy to .env and edit; nothing here is required to
# boot, but the warnings on startup tell you what is missing.
# ---------------------------------------------------------------------------

# --- app -------------------------------------------------------------------
# Set this. Without it a random key is generated at boot and every restart
# signs everyone out.  Generate one with:  python -c "import secrets;print(secrets.token_hex(32))"
JOBSCOUT_SECRET_KEY=
JOBSCOUT_HOST=127.0.0.1
JOBSCOUT_PORT=8050
JOBSCOUT_DEBUG=0
# Turn on when serving over TLS, so the session cookie is marked Secure.
JOBSCOUT_HTTPS=0
JOBSCOUT_SESSION_DAYS=14
JOBSCOUT_CITY=Marrakech, Morocco
# JOBSCOUT_DB=data/jobscout.sqlite3

# --- who can sign up -------------------------------------------------------
# The first account created is always allowed and always becomes an admin.
JOBSCOUT_ALLOW_SIGNUP=1
# Optional: require this code on every signup after the first.
JOBSCOUT_INVITE_CODE=

# --- scoring weights (re-score from the admin panel after changing) --------
JOBSCOUT_W_RATING=0.35
JOBSCOUT_W_REVIEWS=0.25
JOBSCOUT_W_GAP=0.25
JOBSCOUT_W_REACH=0.15

# --- Gemini ----------------------------------------------------------------
# Get one at https://aistudio.google.com/apikey.
# Without a key the AI buttons are disabled and the rest of the app works.
GEMINI_API_KEY=
JOBSCOUT_AI_MODEL=gemini-2.5-pro
JOBSCOUT_AI_EFFORT=medium
JOBSCOUT_AI_MAX_TOKENS=4000

# --- email -----------------------------------------------------------------
# Dry run defaults to ON: sends are recorded in the log but never delivered.
# Turn it off only once the SMTP settings below are correct.
JOBSCOUT_MAIL_DRY_RUN=1
JOBSCOUT_SMTP_HOST=
JOBSCOUT_SMTP_PORT=587
JOBSCOUT_SMTP_USER=
JOBSCOUT_SMTP_PASSWORD=
JOBSCOUT_SMTP_STARTTLS=1
JOBSCOUT_SMTP_SSL=0
JOBSCOUT_MAIL_FROM=
JOBSCOUT_MAIL_FROM_NAME=JobScout
JOBSCOUT_MAIL_REPLY_TO=
JOBSCOUT_MAIL_DAILY_CAP=60
